# syntax=docker/dockerfile:1

# The Alpine line: `timescale/timescaledb` instead of `timescale/timescaledb-ha`,
# 129MB compressed against the HA image's 649MB, carrying the same extensions the
# HA image installs (TimescaleDB TSL, timescaledb_toolkit, pg_textsearch,
# pgfincore) at the same versions. No PostGIS, no SSL init and no
# Patroni/pgBackRest: this one is built for test databases, which are created
# empty and thrown away.
#
# The extensions the base lacks are compiled here against musl, so they are
# NOT the binaries timescaledb-ha ships — a production database belongs on an
# image from the pgMAJOR-tsLINE line, not on this one.

ARG BASE=timescale/timescaledb:2.29.1-pg18

FROM ${BASE} AS build-base
RUN apk add --no-cache build-base clang21 clang21-dev llvm21-dev git \
  openssl-dev icu-dev readline-dev zlib-dev flex bison binutils
ENV PG_CONFIG=/usr/local/bin/pg_config

FROM build-base AS textsearch
ARG TEXTSEARCH_VERSION=1.3.0
# every version below is the one timescale/timescaledb-ha:pg18.4-ts2.29.1 ships,
# read off its own .control files, so the two lines offer the same extension set
RUN git clone --depth 1 -b "v${TEXTSEARCH_VERSION}" \
  https://github.com/timescale/pg_textsearch.git /src
WORKDIR /src
RUN make -j"$(nproc)" && make DESTDIR=/out install \
  && find /out -name '*.so' -exec strip --strip-unneeded {} +

FROM build-base AS pgfincore
ARG PGFINCORE_VERSION=1.4.0
# alpine has no pgfincore package at all, so musl gets it from source
RUN git clone --depth 1 -b "${PGFINCORE_VERSION}" \
  https://github.com/klando/pgfincore.git /src
WORKDIR /src
RUN make -j"$(nproc)" && make DESTDIR=/out install \
  && find /out -name '*.so' -exec strip --strip-unneeded {} +

FROM build-base AS toolkit
ARG TOOLKIT_VERSION=1.24.0
# toolkit's own Cargo.toml pins pgrx with `=`, so this has to track the tag above
ARG PGRX_VERSION=0.18.1
# rustfmt is not optional: pgrx generates pg18.rs and then shells out to it, so
# the build dies three minutes in without it
RUN apk add --no-cache cargo rust rustfmt
ENV CARGO_HOME=/cargo PATH=/cargo/bin:$PATH
RUN cargo install cargo-pgrx --version "${PGRX_VERSION}" --locked
RUN git clone --depth 1 -b "${TOOLKIT_VERSION}" \
  https://github.com/timescale/timescaledb-toolkit.git /src
WORKDIR /src/extension
RUN cargo pgrx init "--pg18=${PG_CONFIG}"
# the unstripped cdylib is 182MB of debug symbols against 14MB of code
RUN cargo pgrx package --pg-config "${PG_CONFIG}" --out-dir /out \
  && find /out -name '*.so' -exec strip --strip-unneeded {} +

FROM ${BASE} AS pruned
# the base is busybox-only, while psql scripts run through `bash` and colour
# their output with `tput`
RUN apk add --no-cache bash ncurses
COPY --from=textsearch /out/usr/local/ /usr/local/
COPY --from=toolkit /out/usr/local/ /usr/local/
COPY --from=pgfincore /out/usr/local/ /usr/local/
# The base ships every TimescaleDB release back to 2.23 so an existing data
# directory can be upgraded in place; a test database starts at the running one.
# That version is read from the base's own control file rather than pinned again
# here, so a Renovate bump of BASE cannot leave this prune deleting the only
# library the image has. timescaledb.so itself stays: it is the loader
# shared_preload_libraries names, and initdb refuses to start without it.
RUN cd /usr/local/share/postgresql/extension \
  && ts=$(sed -n "s/^default_version = '\(.*\)'/\1/p" timescaledb.control) \
  && test -n "$ts" \
  && ls timescaledb--*.sql | grep -vx "timescaledb--${ts}.sql" | xargs -r rm -f \
  && cd /usr/local/lib/postgresql \
  && ls timescaledb-*.so | grep -v -- "-${ts}.so" | xargs -r rm -f \
  && rm -rf bitcode

# mimalloc instead of musl's mallocng. mallocng maps ~64 KiB blocks straight
# from the kernel and hands them back on free: over a seed import plus a
# 2M-row hypertable workload that is 107,016 munmap calls under mallocng
# against 22 under mimalloc. A/B of this image against the unpatched one, 4
# reps alternating order, cgroup usage_usec, every pair mallocng vs mimalloc:
# seed import 1365 vs 775 ms (1.76x), compress_chunk 2583 vs 1437 ms (1.80x),
# whole workload 13956 vs 11936 ms (1.17x), all three spreads disjoint. The
# 2M-row INSERT (9240 vs 8852 ms) and the time_bucket aggregate (888 vs 750)
# stay inside the noise. Each rep greps the postmaster's /proc/1/maps and
# refuses to compare when the library did not load, because a musl-vs-musl
# run reads as a null result rather than as a broken one. See
# https://github.com/the-HipHipHip/Planner/pull/821.
#
# Linked in as a DT_NEEDED entry rather than preloaded, for two reasons.
# `ENV LD_PRELOAD` does not survive the entrypoint's `exec gosu postgres`,
# which is a setuid exec and therefore drops the variable; and musl has no
# /etc/ld.so.preload, so the environment is the only other mechanism it
# offers. patchelf prepends the entry, which is what makes it win `malloc`:
# musl resolves a symbol by walking the load order, and libc.musl is the last
# DT_NEEDED on every one of these binaries.
#
# -insecure omits the guard pages and the free-list encoding. That is
# acceptable HERE and nowhere else: this image is built for throwaway test
# databases, is consumed only by CI, and must never back a real one.
#
# Scope is the PostgreSQL suite, not the whole filesystem: busybox backs
# /bin/sh and 215 other names, so patching it would put the entrypoint at
# risk for allocations that cost nothing.
RUN apk add --no-cache mimalloc2-insecure \
  && apk add --no-cache --virtual .patchelf patchelf \
  && patched=0 \
  && for b in /usr/local/bin/*; do \
       [ -f "$b" ] || continue; \
       head -c4 "$b" | grep -q ELF || continue; \
       patchelf --add-needed libmimalloc-insecure.so.2 "$b"; \
       patched=$((patched + 1)); \
     done \
  && test "$patched" -ge 30 \
  && patchelf --print-needed /usr/local/bin/postgres | head -1 \
     | grep -qx libmimalloc-insecure.so.2 \
  && apk del .patchelf

# Both suites run against the published image over the network rather than
# against this tree, so this stage only has to carry the test runner out. The
# pg_regress binary and pg_textsearch's own test/ directory already sit in the
# `textsearch` stage, which CI builds with --target.
FROM toolkit AS toolkit-tests
RUN cargo build --release --manifest-path /src/tools/sql-doctester/Cargo.toml

# a deletion in a derived layer still ships the bytes it deleted, so the prune
# above only pays off once the whole tree is re-exported as a single layer
FROM scratch
COPY --from=pruned / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  GOSU_VERSION=1.19 \
  LANG=en_US.utf8 \
  PG_MAJOR=18 \
  PG_VERSION=18.6 \
  PGDATA=/var/lib/postgresql/18/docker
VOLUME /var/lib/postgresql
WORKDIR /
EXPOSE 5432
STOPSIGNAL SIGINT
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
